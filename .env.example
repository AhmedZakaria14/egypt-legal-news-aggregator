# ============================================================
# Egypt Legal News Aggregator — environment variables (example)
# Copy this file to ".env.local" and fill in your real values.
# NEVER commit your real .env.local to Git.
# ============================================================

# Anthropic (Claude) API key — required for AI draft generation
# (بوستات فيسبوك + سكربتات فيديو) and for AI legal scoring.
# Without it: scoring falls back to keyword-based scoring, and the
# generation endpoints return a clear Arabic error message.
ANTHROPIC_API_KEY=<redacted>

# Claude model used for batch legal scoring of new stories.
SCORING_MODEL=claude-haiku-4-5-20251001

# Claude model used for generating Facebook posts / video scripts.
GENERATION_MODEL=claude-sonnet-4-5-20250929

# Path to the SQLite database file.
# Local default: ./data/app.db
# On Vercel (ephemeral filesystem) use: /tmp/app.db
DATABASE_FILE=./data/app.db

# Optional password gate for the whole dashboard.
# If set, visitors must log in with this password before seeing
# any page or API. If left empty/unset, the dashboard is open
# (same behavior as the original hosted dashboard).
DASHBOARD_PASSWORD=
